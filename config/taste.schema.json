{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Taste Generated Rule File",
  "description": "Schema for the rule file generated by the paid critique tool.",
  "type": "object",
  "properties": {
    "projectId": { "type": "string" },
    "auditDate": { "type": "string", "format": "date-time" },
    "genericFindings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "direction": {
      "type": "object",
      "properties": {
        "dimensions": { "type": "array" },
        "concept": { "type": "string" }
      },
      "required": ["dimensions", "concept"]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "selector": { "type": "string" },
          "property": { "type": "string" },
          "value": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["selector", "property", "value", "reason"]
      }
    },
    "appliedTo": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["projectId", "auditDate", "direction", "rules"]
}
